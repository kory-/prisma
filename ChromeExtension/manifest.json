{
  "manifest_version": 3,
  "name": "Prisma Tabs",
  "version": "0.3.0",
  "minimum_chrome_version": "119",
  "description": "__MSG_extension_description__",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "favicon",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Prisma Tabs",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "page-audio.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start",
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "relay.js"
      ],
      "world": "ISOLATED",
      "all_frames": true,
      "run_at": "document_start",
      "match_origin_as_fallback": true
    }
  ],
  "default_locale": "en"
}
